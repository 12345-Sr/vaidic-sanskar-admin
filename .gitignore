# -----------------------------------------------------------------------------
# Root .gitignore for vaidic-sanskar-admin
# -----------------------------------------------------------------------------

# Sensitive & Secret Files
google-services.json
**/google-services.json
GoogleService-Info.plist
**/GoogleService-Info.plist
*.pem
*.key
*.cert
*.crt

# Environment variables
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*.local

# Dependencies
node_modules/
**/node_modules/

# Production Build Artifacts
dist/
dist-ssr/
build/
*.tsbuildinfo

# Package manager & System logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS generated files
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db

# IDE and Editor configurations
.vscode/
**/.vscode/
.idea/
**/.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
